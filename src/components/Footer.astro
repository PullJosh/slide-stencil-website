---
import Center from "./Center.astro";
---

<div class="bg-amber-100">
  <Center>
    <div class="py-8 text-lg flex justify-between">
      <div>
        <p>
          Created by <a
            href="https://www.joshuapullen.com/"
            class="font-semibold underline hover:decoration-dashed"
          >
            Mr. Pullen
          </a>
        </p>
        <p>
          &copy; {new Date().getFullYear()} Slide Stencil
        </p>
      </div>
      <div class="text-right">
        <p>
          <a
            href="/privacy"
            class="font-semibold underline hover:decoration-dashed"
          >
            Privacy Policy
          </a>
        </p>
        <p>
          <a
            href="/terms"
            class="font-semibold underline hover:decoration-dashed"
          >
            Terms of Service
          </a>
        </p>
      </div>
    </div>
  </Center>
</div>
