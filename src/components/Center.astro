---
interface Props {
  class?: string;
  width?: "medium" | "large";
}

const { width = "medium" } = Astro.props;
---

<div
  class:list={[
    "px-8 sm:px-16 w-full mx-auto",
    {
      "max-w-4xl": width === "medium",
      "max-w-7xl": width === "large",
    },
    Astro.props.class,
  ]}
>
  <slot />
</div>
