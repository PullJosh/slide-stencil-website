---
import Center from "./Center.astro";
import logo from "../images/logo.svg";
---

<header class="py-4">
  <Center class:list="flex items-center">
    <div
      class="grid gap-x-3 items-center grid-cols-[auto_auto] grid-rows-2 sm:grid-cols-[auto_auto_auto] sm:grid-rows-1 whitespace-nowrap"
    >
      <a href="/" class="row-span-2 sm:row-span-1">
        <img src={logo.src} class="size-14" />
      </a>
      <a href="/" class="leading-tight font-bold text-2xl hover:underline">
        Slide Stencil
      </a>
      <a
        href="https://www.joshuapullen.com/"
        class="leading-tight text-lg sm:text-2xl hover:underline"
      >
        by Mr. Pullen
      </a>
    </div>
    <a
      href="#"
      class="ml-auto hidden sm:block bg-amber-300 text-amber-950 text-lg px-6 py-3 rounded-lg hover:bg-amber-400 hover:scale-110 hover:-rotate-1 active:bg-amber-500 active:scale-95 active:rotate-1 transform transition"
    >
      Install Add-on
    </a>
  </Center>
</header>
